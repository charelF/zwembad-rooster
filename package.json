{
  "name": "zwembad-rooster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run types && pnpm run typecheck && pnpm run deploy:dry",
    "deploy:worker": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev --test-scheduled",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
